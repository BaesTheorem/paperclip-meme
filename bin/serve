#!/bin/bash
# Static server for the generator. launchd runs this through /bin/bash on
# purpose: a bare /usr/bin/python3 in ProgramArguments cannot read ~/Documents
# under launchd (TCC), while bash holds the grant and python inherits it.
set -e
cd "$(dirname "$0")/.."
exec /usr/bin/python3 -m http.server "${PORT:-5031}" --bind 127.0.0.1
