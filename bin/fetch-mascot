#!/bin/sh
# Pull the mascot art from the original tool. It is gitignored: local copy, not
# redistributed here. Run once after cloning.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
curl -fsSL -A "Mozilla/5.0" "${1:-https://kirk.is/tools/clippy/clippy.webp}" -o "$dir/clippy.webp"
echo "clippy.webp: $(wc -c < "$dir/clippy.webp" | tr -d ' ') bytes"
