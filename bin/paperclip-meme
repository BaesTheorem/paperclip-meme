#!/bin/sh
# Serve the generator on localhost and open it.
#
# Served rather than opened as a file:// path on purpose: the PNG export has to
# read clippy.webp back out as a data URL, and both fetch() and canvas export are
# blocked on file:// origins.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
port=${PORT:-5031}
cd "$dir"
if ! nc -z 127.0.0.1 "$port" 2>/dev/null; then
  python3 -m http.server "$port" --bind 127.0.0.1 >/dev/null 2>&1 &
  sleep 0.6
fi
open "http://127.0.0.1:$port/"
echo "serving $dir on http://127.0.0.1:$port/"
